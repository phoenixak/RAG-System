# Copy to .env and fill in.

# ── API ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
# username:bcrypt-hash:role, comma-separated. Roles: read_only, standard_user, power_user, admin
# Make a hash with:  python -m api.auth "a strong password"   (run from src/)
API_USERS=admin:$2b$12$replace-with-a-real-bcrypt-hash.........................:admin
LOAD_SAMPLE_CORPUS=1

# ── Retrieval ────────────────────────────────────────────────────────────
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_TOP_K=3
RAG_MIN_RELEVANCE=-4.0
# RAG_PERSIST_DIR=./data/chroma   # keep the index on disk (set automatically in Docker)

# ── Generation ───────────────────────────────────────────────────────────
# llamacpp (local GGUF on CPU) | openai (any OpenAI-compatible endpoint) | anthropic | none (extractive)
RAG_LLM_BACKEND=llamacpp
RAG_LLM_REPO=unsloth/Qwen3-1.7B-GGUF
RAG_LLM_FILE=Qwen3-1.7B-Q4_K_M.gguf
# RAG_OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
# RAG_OPENAI_MODEL=qwen2.5:7b
# RAG_OPENAI_API_KEY=
# RAG_ANTHROPIC_API_KEY=
